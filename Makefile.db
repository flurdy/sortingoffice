seed-relays:
	@echo "🌱 Seeding relays table..."
	@if [ -f "seed_data/relays.sql" ]; then \
		mysql -u$(MYSQL_USER) -p$(MYSQL_PASSWORD) -h$(MYSQL_HOST) -P$(MYSQL_PORT) $(MYSQL_DATABASE) < seed_data/relays.sql; \

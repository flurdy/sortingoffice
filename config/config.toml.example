# Sorting Office Configuration

# Global feature toggles (apply to all databases unless overridden)
[global_features]
read_only = false           # Set to true to make all databases read-only
no_new_users = false        # Set to true to prevent new user creation on all databases
no_new_domains = false      # Set to true to prevent new domain creation on all databases
no_password_updates = false # Set to true to prevent password changes on all databases

# Production Safety: Seeding and migrations are automatically blocked when:
# - ENVIRONMENT=production or ENVIRONMENT=prod is set
# - Global read_only = true is set
# - Database-specific no_seeding = true is set (for seeding)
# - Database-specific no_migrations = true is set (for migrations)
# - Database-specific disabled = true is set
# - Database-specific read_only = true is set

# Optional Tables: Some databases may not have all tables available
# - no_relays = true: Disable relays table functionality
# - no_relocated = true: Disable relocated table functionality  
# - no_clients = true: Disable clients table functionality

# Required aliases that must exist for all domains
required_aliases = [
    "postmaster",
    "abuse",
    "hostmaster"
]

# Common aliases that are typically useful
common_aliases = [
    "webmaster",
    "admin",
    "support",
    "info",
    "noreply",
    "no-reply",
    "security",
    "help",
    "contact",
    "sales",
    "marketing",
    "hr",
    "finance",
    "legal", 
    "privacy",
    "dmca",
    "spam"
]

# Mail servers for MX compliance checking
# These servers will be used in the MX Servers Report to check if domains
# are using the correct mail servers for email delivery
mail_servers = [
    "mail.example.com",
    "mx1.example.com", 
    "mx2.example.com"
]

# Database connections
# Define one or more database servers this instance can manage
# Each entry must have a unique id, a label for the UI, and a connection url
[[databases]]
id = "primary"
label = "Main Server"
url = "mysql://sortingoffice:password@localhost:3306/sortingoffice"

# Connection pooling configuration
[databases.connection_pool]
max_size = 20                    # Maximum number of connections in the pool
min_idle = 5                     # Minimum number of idle connections to maintain
connection_timeout = 30          # Timeout for acquiring a connection (seconds)
idle_timeout = 300               # Timeout for idle connections (seconds)
max_lifetime = 1800              # Maximum lifetime of connections (seconds)
test_on_acquire = true           # Test connections when acquiring from pool
test_on_return = false           # Test connections when returning to pool

# Optional: Database-specific feature restrictions (override global settings)
[databases.features]
read_only = false           # Set to true to make this database read-only
no_new_users = false        # Set to true to prevent new user creation
no_new_domains = false      # Set to true to prevent new domain creation
no_password_updates = false # Set to true to prevent password changes
disabled = false            # Set to true to completely disable this database
no_seeding = false          # Set to true to prevent seeding operations
no_migrations = false       # Set to true to prevent migration operations
no_relays = false           # Set to true to disable relays table functionality
no_relocated = false        # Set to true to disable relocated table functionality
no_clients = false          # Set to true to disable clients table functionality

# Example: Field mapping for schema differences
# Use table-qualified field names to map fields for specific tables
# Format: "table.field" = "actual_database_field_name"
[databases.field_map]
# Users table field mappings
users.id = "user_id"
users.enabled = "is_active"
users.email = "email_address"

# Domains table field mappings  
domains.id = "domain_id"
domains.enabled = "is_active"

# Aliases table field mappings
aliases.id = "alias_id"
aliases.enabled = "is_active"

# Backward compatibility: simple field names still work
# enabled = "is_active"  # This would apply to all tables if not overridden

[[databases]]
id = "backup"
label = "Backup Server"
url = "mysql://backupuser:password@backuphost:3306/backupdb"

# Connection pooling for backup server (smaller pool for read-only)
[databases.connection_pool]
max_size = 10                    # Smaller pool for backup server
min_idle = 2                     # Fewer idle connections
connection_timeout = 15          # Shorter timeout for backup
idle_timeout = 600               # Longer idle timeout for backup
max_lifetime = 3600              # Longer lifetime for backup connections
test_on_acquire = true           # Always test backup connections
test_on_return = true            # Test when returning to pool

# Example: Read-only backup server
[databases.features]
read_only = true            # Backup server is read-only
no_new_users = true         # No new users on backup
no_new_domains = true       # No new domains on backup
no_password_updates = true  # No password updates on backup
disabled = false            # Database is enabled but restricted
no_seeding = true           # Prevent seeding on backup server
no_migrations = true        # Prevent migrations on backup server
no_relays = true            # Backup server doesn't have relays table
no_relocated = true         # Backup server doesn't have relocated table
no_clients = true           # Backup server doesn't have clients table
# Example: Field mapping for schema differences
# Use table-qualified field names to map fields for specific tables
[databases.field_map]
# Users table field mappings
users.id = "id"
users.enabled = "enabled"
users.email = "mail"

# Domains table field mappings
domains.id = "id"
domains.enabled = "enabled"

# Aliases table field mappings
aliases.id = "id"
aliases.enabled = "enabled"

# Example: Completely disabled staging server
# [[databases]]
# id = "staging"
# label = "Staging Server (Disabled)"
# url = "mysql://staginguser:password@staginghost:3306/stagingdb"
# [databases.features]
# read_only = false         # Not relevant when disabled
# no_new_users = false      # Not relevant when disabled
# no_new_domains = false    # Not relevant when disabled
# no_password_updates = false # Not relevant when disabled
# disabled = true           # Database is completely disabled

# Admin users configuration
# You can have multiple admin users with different roles
[[admins]]
username = "admin"
# This is the bcrypt hash for "admin123" - CHANGE THIS!
password_hash = "$2a$12$o8thacsiGCRhN1JN8xnW6e0KqNb7KrSgM67xxa62RKoAC9fOPf.aO"
role = "edit"  # Can be "edit" or "read-only"

# Example of a read-only admin
# [[admins]]
# username = "viewer"
# password_hash = "$2a$12$..."  # Generate this with bcrypt
# role = "read-only"



# Contact information for the application maintainer (optional)
# This information will be displayed on the contact page
# You can specify either email OR contact_form, or both
[contact]
name = "John Doe"
# Option 1: Email address
email = "admin@example.com"
# Option 2: Contact form URL (alternative to email)
# contact_form = "https://example.com/contact"
role = "System Administrator"  # Optional role/title
